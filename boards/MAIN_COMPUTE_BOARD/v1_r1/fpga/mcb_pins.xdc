set_property -dict {PACKAGE_PIN K2   IOSTANDARD LVDS_25     } [get_ports mezz_la10_p]
set_property -dict {PACKAGE_PIN H5   IOSTANDARD LVDS_25     } [get_ports mezz_la11_n]
set_property -dict {PACKAGE_PIN J5   IOSTANDARD LVDS_25     } [get_ports mezz_la11_p]
set_property -dict {PACKAGE_PIN G3   IOSTANDARD LVDS_25     } [get_ports mezz_la12_n]
set_property -dict {PACKAGE_PIN H3   IOSTANDARD LVDS_25     } [get_ports mezz_la12_p]
