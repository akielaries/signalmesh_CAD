set_property -dict {PACKAGE_PIN K1   IOSTANDARD LVDS_25     } [get_ports mezz_la08_p]
set_property -dict {PACKAGE_PIN G2   IOSTANDARD LVDS_25     } [get_ports mezz_la09_n]
set_property -dict {PACKAGE_PIN H2   IOSTANDARD LVDS_25     } [get_ports mezz_la09_p]
