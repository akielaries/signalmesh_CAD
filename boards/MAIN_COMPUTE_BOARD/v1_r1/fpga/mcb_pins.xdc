set_property -dict {PACKAGE_PIN L5   IOSTANDARD LVDS_25     } [get_ports mezz_la16_p]

# card-to-carrier clocks: internal differential termination
set_property DIFF_TERM TRUE [get_ports mezz_clk1_m2c_p]
set_property DIFF_TERM TRUE [get_ports mezz_clk0_m2c_p]

# transceivers (quad 216): location only, no IOSTANDARD on MGT pins
set_property PACKAGE_PIN A8   [get_ports gtp0_rx_n]
set_property PACKAGE_PIN B8   [get_ports gtp0_rx_p]
set_property PACKAGE_PIN A4   [get_ports gtp0_tx_n]
set_property PACKAGE_PIN B4   [get_ports gtp0_tx_p]
set_property PACKAGE_PIN C11  [get_ports gtp1_rx_n]
set_property PACKAGE_PIN D11  [get_ports gtp1_rx_p]
set_property PACKAGE_PIN C5   [get_ports gtp1_tx_n]
set_property PACKAGE_PIN D5   [get_ports gtp1_tx_p]
set_property PACKAGE_PIN A6   [get_ports gtp2_tx_n]
set_property PACKAGE_PIN B6   [get_ports gtp2_tx_p]
set_property PACKAGE_PIN C7   [get_ports gtp3_tx_n]
set_property PACKAGE_PIN D7   [get_ports gtp3_tx_p]
set_property PACKAGE_PIN E6   [get_ports gtp_refclk0_n]
set_property PACKAGE_PIN F6   [get_ports gtp_refclk0_p]
set_property PACKAGE_PIN E10  [get_ports gtp_refclk1_n]
set_property PACKAGE_PIN F10  [get_ports gtp_refclk1_p]
set_property PACKAGE_PIN F8   [get_ports gtp_rref]

# clocks
create_clock -period 10.000 -name sysclk_100m [get_ports sysclk_100m]
create_clock -period 8.000 -name fmc_clk [get_ports fmc_clk]
create_clock -period 8.000 -name gtp_refclk0 [get_ports gtp_refclk0_p]
# gtp_refclk1 (VITA GBTCLK0_M2C) and mezz_clk0/1_m2c depend on the card: add create_clock per card
set_property INTERNAL_VREF 0.675 [get_iobanks 34]
