(version 1)

# impedance: 10 layers, 1.6 mm (see docs/pcb.md), widths from 2D field solve (outer microstrip / inner stripline)
(rule "SE50 inner"
	(layer inner)
	(condition "A.NetClass == 'SE50' || A.NetClass == 'DDR'")
	(constraint track_width (min 0.12) (opt 0.127) (max 0.135)))

(rule "DIFF100 inner"
	(layer inner)
	(condition "A.NetClass == 'DIFF100'")
	(constraint track_width (min 0.089) (opt 0.09) (max 0.10))
	(constraint diff_pair_gap (min 0.12) (opt 0.125) (max 0.16)))

(rule "USB90 inner"
	(layer inner)
	(condition "A.NetClass == 'USB90'")
	(constraint track_width (min 0.105) (opt 0.11) (max 0.115))
	(constraint diff_pair_gap (min 0.10) (opt 0.106) (max 0.12)))

(rule "DIFF100 outer"
	(layer outer)
	(condition "A.NetClass == 'DIFF100'")
	(constraint track_width (min 0.095) (opt 0.10) (max 0.105))
	(constraint diff_pair_gap (min 0.17) (opt 0.18) (max 0.19)))

(rule "USB90 outer"
	(layer outer)
	(condition "A.NetClass == 'USB90'")
	(constraint track_width (min 0.105) (opt 0.11) (max 0.115))
	(constraint diff_pair_gap (min 0.12) (opt 0.127) (max 0.135)))

# bga escape under the fpga and ddr
(rule "BGA escape"
	(condition "A.intersectsCourtyard('U100') || A.intersectsCourtyard('U21') || A.intersectsCourtyard('U11')")
	(constraint track_width (min 0.09))
	(constraint clearance (min 0.09)))

# vita 57.1 pin field: 1.27 mm array, a coupled pair fits between pin columns at 0.10
(rule "VITA escape"
	(condition "A.intersectsCourtyard('J20')")
	(constraint clearance (min 0.10)))

# keep audio analog away from digital
(rule "DAC clearance"
	(condition "A.NetClass == 'DAC' && B.NetClass != 'DAC' && B.NetClass != 'PWR'")
	(constraint clearance (min 0.3)))

# stm32 tfbga265 escape: the 0.8 mm via field and the staggered ring just outside it
(rule "STM32 escape"
	(condition "A.intersectsArea('STM32_ESC')")
	(constraint track_width (min 0.09))
	(constraint clearance (min 0.09)))
