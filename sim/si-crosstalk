#!/home/akiel/opt/openEMS/venv/bin/python3
# tier-3 crosstalk harness. auto-places gerber2ems ports from trace geometry.
#   python si-crosstalk <board> <aggressor> [victim ...]
#   python si-crosstalk <board> <aggressor> --auto 2        # pick worst 2 victims
#   ... --run       also run gerber2ems (-g/-s/-p) and report NEXT/FEXT
# net names may be given without the leading net path (e.g. FMC_NWAIT).

import sys
import os
import argparse
import subprocess

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from si import config, kicad, crosstalk


def resolve(board, name):
    if name in board.nets:
        return name
    hits = [n for n in board.nets if name in n]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit("no net matches %r" % name)
    exact = [n for n in hits if n.split("/")[-1] == name]
    if len(exact) == 1:
        return exact[0]
    sys.exit("ambiguous net %r: %s" % (name, hits[:6]))


def main():
    ap = argparse.ArgumentParser(description="auto crosstalk sim setup (gerber2ems)")
    ap.add_argument("board")
    ap.add_argument("aggressor")
    ap.add_argument("victims", nargs="*")
    ap.add_argument("--auto", type=int, default=0, help="auto-pick N worst-coupled victims")
    ap.add_argument("--run", action="store_true", help="also run gerber2ems and report")
    args = ap.parse_args()

    cfg = config.load(args.board)
    if not cfg.ems_dir or not os.path.isdir(cfg.ems_dir):
        sys.exit("board %s has no staged ems_dir (gerbers). set ems_dir in its yaml." % cfg.name)
    board = kicad.load(cfg.kicad_pcb)
    agg = resolve(board, args.aggressor)

    victims = [resolve(board, v) for v in args.victims]
    if args.auto:
        found = crosstalk.find_victims(board, agg, args.auto)
        print("worst-coupled victims for %s:" % agg)
        for c, n in found:
            print("   %.1f mm parallel  %s" % (c, n))
        victims = [n for _, n in found]
    if not victims:
        sys.exit("give victim nets or use --auto N")

    ports = crosstalk.plan(board, agg, victims)
    print("\nplanned ports (net, role, x, y, rot):")
    for i, p in enumerate(ports):
        print("  SP%d  %-22s %-8s (%.2f, %.2f) rot %d" %
              (i + 1, p["net"], p["role"], p["x"], p["y"], p["rot"]))
    sj, pf = crosstalk.write_config(cfg.ems_dir, ports, agg, victims)
    print("\nwrote %s\n      %s" % (sj, pf))

    run_cmds = [
        "cd %s" % cfg.ems_dir,
        "gerber2ems -g --export-field cu-inner 2>&1 | tee geom.log",
        "gerber2ems -s 2>&1 | tee sim.log",
        "gerber2ems -p 2>&1 | tee post.log",
    ]
    if not args.run:
        print("\nrun it:")
        for c in run_cmds:
            print("   " + c)
        print("\nthen re-run with --run to parse NEXT/FEXT, or read the S-params yourself.")
        return

    for c in run_cmds[1:]:
        print("\n$ " + c)
        subprocess.run(c, shell=True, cwd=cfg.ems_dir)
    sp = crosstalk.read_sparams(cfg.ems_dir)
    if not sp:
        sys.exit("no S-params produced")
    print("\n=== crosstalk (excite aggressor, worst-case over 0.1-3 GHz) ===")
    for tag, label in [("through", "aggressor through S21"),
                       ("next", "near-end xtalk NEXT S31"),
                       ("fext", "far-end xtalk  FEXT S41")]:
        if tag + "_worst_db" in sp:
            print("  %-24s %+6.1f dB" % (label, sp[tag + "_worst_db"]))


if __name__ == "__main__":
    main()
