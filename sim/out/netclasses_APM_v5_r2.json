        "netclass": "slow"
      },
      {
        "pattern": "/.*(DAC|AUDIO|OUT_[LR]|VOL_).*/",
        "netclass": "audio_analog"
      },
      {
        "pattern": "/.*(FMC_(DA\\d+|A\\d+|N\\w+|CLK)).*/",
