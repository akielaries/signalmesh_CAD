	(text "ANALOG FILTER / CV  (stereo)  -  SPI in (10-pin FFC) -> DAC8565 makes CVs -> per-channel LM13700 VCF/VCA; CD4053 selects analog or FPGA-digital" (exclude_from_sim no) (at 18 15 0) (effects (font (size 2.2 2.2) ) (justify left bottom)) (uuid "e4aaca4e-2b39-4eb2-bb47-c74dcadcc4b2"))
	(text "CONTROL  -  one 10-pin control FFC (on the root) feeds this DAC (CS_DAC1) + the FX DAC + the MCP expander over ONE shared SPI bus. MODE_SEL from the expander." (exclude_from_sim no) (at 20 28 0) (effects (font (size 1.5 1.5) ) (justify left bottom)) (uuid "9ebb0a42-fe2f-4bcd-b687-6e1caa4ae312"))
