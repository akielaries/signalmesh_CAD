	(text "ANALOG FILTER / CV  (stereo)  -  SPI in (10-pin FFC) -> DAC8565 makes CVs -> per-channel LM13700 VCF/VCA; CD4053 selects analog or FPGA-digital"
		(exclude_from_sim no)
		(at 18 15 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "0aaf569a-93ed-485a-87d3-6d16713621f5")
	)
	(text "CV SUMMER  -  DAC CV_CUTOFF + CV_MOD summed by U5 -> VCUTOFF (drives both L and R VCFs); knob lives on the control board"
		(exclude_from_sim no)
		(at 20 112 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left bottom)
		)
		(uuid "10a4338a-d66e-42bb-8234-76a2c8662977")
	)
	(text "FILT_x_IN / FILT_x_OUT are the hierarchical pins shared with the root (front-end) sheet.  Power rails (+5V/-5V/GND) are global."
		(exclude_from_sim no)
		(at 20 285 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "2101b82e-16b3-4f97-9ce7-62a27ff54fb7")
	)
	(text "VCF+VCA R  -  LM13700 OTA lowpass then OTA VCA (NOTE: OTA/Iabc topology - verify vs datasheet)"
		(exclude_from_sim no)
		(at 20 220 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "79f34e77-ccab-4d10-af58-c29be9d80be1")
	)
	(text "TOGGLE  -  CD4053: MODE_SEL selects analog (VCA_x_OUT) vs bypass (FILT_x_IN) for BOTH L and R"
		(exclude_from_sim no)
		(at 300 44 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a826bd91-c356-406d-915d-a09e943b109a")
	)
	(text "VCF+VCA L  -  LM13700 OTA lowpass then OTA VCA (NOTE: OTA/Iabc topology - verify vs datasheet)"
		(exclude_from_sim no)
		(at 20 155 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "e6fad7c9-d2ad-4f0f-a909-9c05e9ee1c1d")
	)
	(text "CONTROL/DAC  -  one 10-pin control FFC (root) feeds this DAC (CS_DAC1) + the FX DAC + MCP over ONE shared SPI bus; MODE_SEL from the expander"
		(exclude_from_sim no)
		(at 20 28 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "edf1105d-79d6-4f0a-9f3e-98dbd72af8bf")
	)
