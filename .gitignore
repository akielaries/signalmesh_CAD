# generated board renders are published to github pages, not committed
boards/**/renders/

# kicad editor lock files
*.lck

# kicad local history/backup dirs (were accidentally tracked as submodules)
.history/
.history_trim/

# python bytecode from tools/
__pycache__/

# kicad zip backups: git history is the backup, and they grow past github limits
*-backups/

# router checkpoints and intermediate boards (kept outside the kicad project dirs)
boards/**/checkpoints/
